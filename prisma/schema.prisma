datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Member {
  id        String   @id @default(cuid())
  name      String
  funcao    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String          @id
  name          String
  category      String
  uom           String          @default("sc")
  weight        Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orderItems    OrderItem[]
  priceItems    PriceTableItem[]
  stockMovements StockMovement[]
}

model PriceTable {
  id     String           @id
  name   String
  prices PriceTableItem[]
  orders Order[]
}

model PriceTableItem {
  id           String     @id @default(cuid())
  priceTableId String
  productId    String
  price        Float
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@unique([priceTableId, productId])
}

model Customer {
  id       String   @id @default(cuid())
  name     String
  cpfcnpj  String?
  IE       String?
  phone    String?
  email    String?
  address  String?
  city     String?

  // COMERCIAL
  tipoCliente   String?
  segmento      String?
  origemLead    String?
  responsavel   String?
  status        String? // ativo, inativo, potencial

  // FINANCEIRO
  vendaPrazo              Boolean @default(false)
  prazoPagamentoPadrao    Int?
  risco                   String? // baixo, medio, alto
  inadimplente            Boolean @default(false)
  scoreInterno            Float?

  // RELACIONAMENTO
  ultimoContato    DateTime?
  proximoFollowUp  DateTime?
  observacoes      String?
  tags             String? // JSON string ou CSV simples

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  crmPipelines CrmPipeline[]
  followUps     FollowUp[]
  tasks         Task[]
}

model FollowUp {
  id          String   @id @default(cuid())
  customerId  String
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  customerId  String
  title       String
  description String?
  status      String   @default("PENDENTE") // pendente, feito
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id               String           @id
  customerId       String
  customerName     String
  customerEmail    String?
  customerPhone    String?
  customerAddress  String?
  customerDocument String?
  city             String?
  status           OrderStatus      @default(PENDENTE)
  productionStage  ProductionStage?
  paymentCondition String
  seller           String
  closedBy         String?
  user             String
  priceTableId     String?
  totalValue       Float            @default(0)
  totalWeight      Float            @default(0)
  observations     String?
  grupoCarga        String?   // Ex: ROTA-UBERLANDIA-01
  tipoCarga         String?   // BATIDA | PALETIZADA
  dataCarregamento  DateTime? 
  stockMovements StockMovement[]


  // Logística
  assignedVehicleId     String?
  assignedDriverId      String?
  acceptedAt            DateTime?
  scheduledDeliveryDate DateTime?
  departureTime         DateTime?
  deliveryDate          DateTime?
  deliveredAt           DateTime?
  

  // Faturamento
  invoicedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?   // Motivo da rejeição financeira
  rejectedBy        String?   // Quem rejeitou
  approvedByFinance DateTime?
  approvedByFinanceUser String? // Quem aprovou financeiramente
  nfNumero          String?
  vendaDiretaNumero String?

  // Produção
  loteId      String?
  loteDate    DateTime?
  approvedAt  DateTime?
  viewedAt    DateTime?

  // Descarga e Entrega
  meioDescarga          MeioDescarga?
  responsavelDescarga   ResponsavelDescarga?
  dataHoraDescarga      DateTime?
  especificidadesEntrega String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      OrderItem[]
  priceTable PriceTable?  @relation(fields: [priceTableId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id])
  crmPipelines  CrmPipeline[]
  ocorrencias Ocorrencia[]

  
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COMERCIAL)
  active    Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogs             AuditLog[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Float
  price      Float
  finalPrice Float?
  discount   Float   @default(0)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}

model Vehicle {
  id         String   @id @default(cuid())
  plate      String   @unique
  model      String
  type       String
  capacityKg Float
  status     String   @default("DISPONIVEL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("DISPONIVEL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliverySchedule {
  id            String   @id @default(cuid())
  vehicleId     String
  driverId      String
  scheduledDate DateTime
  scheduledTime String?
  status        String   @default("AGENDADO")
  notes         String?
  orderIds      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Carregamento {
  id                    String   @id @default(cuid())
  grupoCarga            String   @unique
  tipoCarga             String   // BATIDA | PALETIZADA
  status                String   @default("CRIADO") // CRIADO, EM_ENTREGA, ENTREGUE, CANCELADO
  dataCarregamento      DateTime
  vehicleId             String?
  scheduledDeliveryDate DateTime?
  orderIds              Json     // Array de IDs de pedidos
  totalSacos            Float    @default(0)
  totalPeso             Float    @default(0)
  totalValor            Float    @default(0)
  observations          String?  // Observações do carregamento
  cityGroups            Json?     // Estrutura: [{city, orders: [], palets: []}]
  romaneio              Json?    // Romaneio por palete
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  palets                Palet[]
  paletHistories        PaletHistory[]
  ocorrencias           Ocorrencia[]
}

model Palet {
  id                String   @id @default(cuid())
  carregamentoId    String
  number            Int
  city              String
  items             Json     // [{productId, clients: [{orderId, customerName, quantity}]}]
  totalWeight       Float    @default(0)
  totalUnits        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  carregamento      Carregamento @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)

  @@index([carregamentoId])
}

model PaletHistory {
  id                String   @id @default(cuid())
  carregamentoId    String
  paletId           String?
  action            String   // 'CRIADO' | 'MODIFICADO' | 'FINALIZADO'
  details           Json     // Detalhes da ação
  createdAt         DateTime @default(now())

  carregamento      Carregamento @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)

  @@index([carregamentoId])
}

model SalesGoal {
  id        String   @id @default(cuid())
  month     Int      @default(1)
  year      Int      @default(2026)
  revenue   Float    @default(0)
  tons      Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model StockMovement {
  id             String   @id @default(cuid())
  productId      String
  type           StockMovementType
  quantity       Float
  unitCost       Float    @default(0)
  totalCost      Float    @default(0)
  reason         String
  relatedOrderId String?
  createdAt      DateTime @default(now())

  product        Product  @relation(fields: [productId], references: [id])
  order          Order?   @relation(fields: [relatedOrderId], references: [id])
}

model CrmPipeline {
  id         String         @id @default(cuid())
  customerId String
  objetivo   String
  coluna     CrmColuna      @default(ENTRADA)

  canal           String?
  proximaAcao     String?
  statusCrm       String?
  resultado       String?
  valorRecuperado Float?
  observacao      String?
  nomeContato     String?
  ultimoContato   DateTime?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer   Customer       @relation(fields: [customerId], references: [id])
  movimentos CrmMovimento[]
  orderId String?
  order   Order? @relation(fields: [orderId], references: [id])
}

model CrmMovimento {
  id         String      @id @default(cuid())
  pipelineId String
  colunaAnterior CrmColuna?
  colunaAtual    CrmColuna
  createdAt  DateTime    @default(now())

  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

enum CrmColuna {
  ENTRADA
  QUALIFICACAO
  PROPOSTA
  FECHADO
}


enum StockMovementType {
  ENTRADA
  SAIDA
}

enum Role {
  ADMIN
  COMERCIAL
  PRODUCAO
  LOGISTICA
}

enum OrderStatus {
  PENDENTE
  FINANCEIRO
  PRODUCAO
  PRONTO_LOGISTICA
  ENTREGA
  AGUARDANDO_FATURAMENTO
  FATURADO
  REJEITADO
  ENTREGUE
}

enum ProductionStage {
  FILA
  PROCESSO
  QUALIDADE
  CONCLUIDO
}

enum MeioDescarga {
  PROPRIO
  AJUDANTE_EXTERNO
  EMPILHADEIRA
}

enum ResponsavelDescarga {
  CLIENTE
  LOTUS
}

enum OcorrenciaStatus {
  PENDENTE
  RESOLVIDO
  CANCELADO
}

enum OcorrenciaTipo {
  ENTREGA
  PRODUTO
  CLIENTE
  VEICULO
  MOTORISTA
  LOGISTICA
  OUTRO
}

model Ocorrencia {
  id                String   @id @default(cuid())
  
  // Relacionamentos
  orderId           String?
  carregamentoId    String?
  
  // Informações de Ocorrência
  tipo              OcorrenciaTipo @default(ENTREGA)
  titulo            String
  descricao         String
  status            OcorrenciaStatus @default(PENDENTE)
  
  // Informações Relacionadas
  dataOcorrencia    DateTime @default(now())
  clienteNome       String?
  motorista         String?
  veiculo           String?
  
  // Resolução
  resolucao         String?
  dataResolucao     DateTime?
  resolvidoPor      String?
  
  // Metadata
  prioridade        String @default("NORMAL") // BAIXA, NORMAL, ALTA, CRITICA
  observacoes       String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  order             Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  carregamento      Carregamento? @relation(fields: [carregamentoId], references: [id], onDelete: SetNull)
  
  @@index([orderId])
  @@index([carregamentoId])
  @@index([status])
  @@index([dataOcorrencia])
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON para armazenar qualquer tipo de valor
  description String?
  type  String // 'boolean', 'number', 'string', 'select'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  type      NotificationType @default(ORDER_STATUS_CHANGED)
  title     String
  message   String
  data      Json?  // Dados adicionais (ex: old status, new status)
  read      Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  orderStatusChanged    Boolean  @default(true)
  orderApprovedFinance  Boolean  @default(true)
  orderRejected         Boolean  @default(true)
  orderDelivered        Boolean  @default(true)
  orderInProduction     Boolean  @default(true)
  orderInDelivery       Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  ORDER_STATUS_CHANGED
  ORDER_APPROVED_FINANCE
  ORDER_REJECTED
  ORDER_DELIVERED
  ORDER_IN_PRODUCTION
  ORDER_IN_DELIVERY
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // ex: LOGIN, CREATE_ORDER, UPDATE_ORDER, DELETE_ORDER, APPROVE_ORDER, etc
  resource  String   // ex: Order, User, Product, etc
  resourceId String?  // ID do recurso afetado
  details   String?   // JSON com detalhes da ação
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

